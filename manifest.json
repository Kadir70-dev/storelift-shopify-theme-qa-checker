{
  "manifest_version": 3,
  "name": "StoreLift — Shopify Theme QA Checker",
  "version": "0.2.0",
  "description": "User-initiated Shopify storefront QA: page checks, open-tab audit, evidence report and local handover checklist. No backend.",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_title": "StoreLift Theme QA Checker",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
}
